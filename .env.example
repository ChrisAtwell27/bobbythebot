# Discord Bot Token
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# OpenAI API Key (for Bobby AI conversations)
OPENAI_API_KEY=your_openai_api_key_here

# Gemini API Key (for Magic 8-Ball fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
PORT=3000

# Mafia Webhook API Configuration
MAFIA_WEBHOOK_PORT=3001
MAFIA_WEBHOOK_SECRET=your_secure_random_secret_here
MAFIA_WEB_ORIGIN=http://localhost:8080

# Valorant API Key (Henrik Dev API)
VALORANT_API_KEY=your_valorant_api_key_here

# GitHub Personal Access Token (optional, for changelog feature)
# Without token: 60 API requests/hour
# With token: 5000 API requests/hour
# Create at: https://github.com/settings/tokens
# Required scopes: 'repo' (if repository is private) or no scopes needed for public repos
GITHUB_TOKEN=your_github_token_here

# Database Configuration
# Choose one: MongoDB or Convex (or use both during migration)

# MongoDB Atlas (legacy)
MONGODB_URI=mongodb+srv://chrisatwell9:Ambyst0ma!@bobbythebot.m7mo0ai.mongodb.net/?appName=BobbyTheBot

# Convex (new - recommended)
# Get this URL by running: npx convex dev
# Format: https://your-project.convex.cloud
CONVEX_URL=your_convex_url_here

# Minecraft Debug Webhook (in-game /debug command)
MC_DEBUG_API_PORT=3004
MC_DEBUG_API_ENABLED=true
# Shared bearer token. The mod ships this, so treat it as a speed bump, not a
# real credential — rate limiting is what protects the forum. Unset = endpoint
# rejects everything with 503.
MC_DEBUG_WEBHOOK_SECRET=your_secure_random_secret_here
# Forum channel that receives the bug report threads
MC_DEBUG_FORUM_CHANNEL_ID=1527727915817762997

# Minecraft forum nudge (points new modded players at the bug forum)
MC_FORUM_GUILD_ID=701308904877064193
# Optional: exact role ids, comma-separated. Overrides matching by role name.
MC_NUDGE_ROLE_IDS=
# "keyword" (default) fires on a bug keyword at any length.
# "keyword-or-length" also fires on any message over 6 words.
MC_NUDGE_MODE=keyword
